{
  "name": "carinyaparc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Carinya Parc site and agent workforce.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "agents": "tsx scripts/agents/cli.ts",
    "gates": "tsx packages/content-pipeline/src/cli.ts",
    "build:brand": "tsx packages/brand/build.ts",
    "monitor": "tsx agents/content-monitor/agent/run.ts",
