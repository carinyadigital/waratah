{
  "name": "carinya-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One portable agent definition, built to any provider.",
  "engines": { "node": ">=24" },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "agent": "tsx packages/agent/src/cli.ts",
    "validate": "tsx packages/agent/src/cli.ts validate",
    "build": "tsx packages/agent/src/cli.ts build",
    "build:check": "tsx packages/agent/src/cli.ts build --check",
    "deploy": "tsx packages/agent/src/cli.ts deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
