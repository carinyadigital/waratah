{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/agent.schema.json",
  "title": "Agent manifest",
  "description": "The register's contract. policy is the load-bearing block. capability is portable. bindings are the only vendor-aware block.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "name", "team", "owner", "description", "tags", "capability", "policy", "bindings", "observability"],
  "properties": {
    "version": { "const": 2 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "team": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 10 },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "capability": { "$ref": "#/$defs/capability" },
    "policy": { "$ref": "#/$defs/policy" },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Team-specific blocks validated against the team's schema fragment."
    },
    "bindings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/binding" }
    },
    "triggers": {
      "type": "array",
      "items": { "$ref": "#/$defs/trigger" }
    },
    "observability": { "$ref": "#/$defs/observability" }
  },
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["conversational", "deterministic", "interactive"] },
        "model": { "enum": ["strong", "standard", "none"] },
        "workflow": { "type": "string", "description": "Step id from the team's workflow.yaml" }
      }
    },
    "binding": {
      "type": "object",
      "required": ["provider"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "mode": { "type": "string" },
        "schedule": { "type": "string" },
        "timezone": { "type": "string" },
        "workflow": { "type": "string", "pattern": "^\\.github/workflows/.+\\.yml$" },
        "harness": { "enum": ["none"] },
        "spendCapAcknowledged": {
          "type": "boolean",
          "description": "Required when the binding's adapter cannot enforce spendCapUsd."
        }
      },
      "additionalProperties": false
    },
    "trigger": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["schedule", "chat", "repo-event", "webhook", "manual"] },
        "cron": { "type": "string" },
        "timezone": { "type": "string" },
        "channel": { "type": "string" },
        "event": { "type": "string" },
        "paths": { "type": "array", "items": { "type": "string" } }
      }
    },
    "write": {
      "enum": [
        "artifact-store",
        "tracker",
        "pr-comment",
        "chat",
        "repo-branch",
        "cms-draft",
        "cms-publish",
        "email-send",
        "social-post",
        "repo-main",
        "deploy"
      ]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["untrustedInput", "connections", "writes", "approval"],
      "properties": {
        "untrustedInput": { "type": "boolean" },
        "connections": { "type": "array", "items": { "type": "string" } },
        "writes": { "type": "array", "items": { "$ref": "#/$defs/write" } },
        "approval": { "enum": ["none", "draft-only", "pr-review", "human"] },
        "spendCapUsd": { "type": "number", "exclusiveMinimum": 0 },
        "idempotencyKey": { "type": "string" },
        "cmsRole": { "type": "string" }
      }
    },
    "observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traces", "alertChannel"],
      "properties": {
        "traces": { "enum": ["none", "platform", "otel", "both"] },
        "alertChannel": { "type": "string" },
        "evals": { "type": "string" }
      }
    }
  }
}
