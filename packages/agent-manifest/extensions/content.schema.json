{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/content-extension.schema.json",
  "title": "Content team manifest extension",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nThreshold": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "clusters": {
      "type": "array",
      "items": { "enum": ["topic-area", "angle-type", "format", "funnel-intent"] }
    },
    "emits": {
      "type": "array",
      "items": { "enum": ["read", "demand", "opportunities", "brief", "landscape"] }
    }
  },
  "if": {
    "properties": { "emits": { "contains": { "const": "read" } } },
    "required": ["emits"]
  },
  "then": { "required": ["nThreshold"] }
}
