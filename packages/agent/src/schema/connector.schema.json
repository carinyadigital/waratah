{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/connector.schema.json",
  "title": "Connector",
  "description": "One MCP server. This and the provider overlay are the only places a vendor is named.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "vendor", "transport"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The capability name the agent knows it by. Swapping vendors keeps this stable."
    },
    "description": { "type": "string", "minLength": 10 },
    "vendor": { "type": "string", "minLength": 2 },
    "readOnly": {
      "type": "boolean",
      "default": false,
      "description": "Declares the server exposes no mutating tools. Documentation, not enforcement."
    },
    "transport": {
      "type": "object",
      "required": ["type"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["type", "url"],
          "properties": {
            "type": { "const": "url" },
            "url": {
              "type": "string",
              "minLength": 1,
              "description": "May contain ${ENV_VAR}, resolved at build time. Keeps endpoints and tokens out of git."
            }
          }
        },
        {
          "additionalProperties": false,
          "required": ["type", "command"],
          "properties": {
            "type": { "const": "stdio" },
            "command": { "type": "string", "minLength": 1 },
            "args": { "type": "array", "items": { "type": "string" } }
          }
        }
      ]
    }
  }
}
