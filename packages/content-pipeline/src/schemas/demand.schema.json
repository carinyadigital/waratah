{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/demand.schema.json",
  "title": "Demand artifact",
  "description": "The audience researcher's output: jobs-to-be-done and the language people actually use. Each theme carries its source and frequency — demand is counted, not vibed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["period", "themes", "couldNotDetermine"],
  "properties": {
    "period": { "type": "string", "pattern": "^[0-9]{4}-(W[0-9]{2}|[0-9]{2})$" },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theme", "jobToBeDone", "language", "source", "frequency"],
        "properties": {
          "theme": { "type": "string", "minLength": 3 },
          "jobToBeDone": { "type": "string", "minLength": 8, "description": "What the person is trying to get done, in one sentence." },
          "language": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 2 },
            "description": "Verbatim phrases people used. Never paraphrased — the language is the data."
          },
          "source": { "enum": ["support-triage", "on-site-search", "serp-intent", "comments", "replies"] },
          "frequency": { "type": "integer", "minimum": 1, "description": "How many times this theme appeared in the period, from that source." }
        }
      }
    },
    "couldNotDetermine": { "type": "array", "items": { "type": "string" } }
  }
}
