{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/draft.schema.json",
  "title": "Staged draft artifact",
  "description": "The structure gate's contract for a staged document: provider-neutral content the studio stages and the gates walk. Drafts live at the team's artifact drafts directory; once staged over the content-store port the same shape is fetched from the CMS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "surface", "content"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 3 },
    "surface": { "enum": ["blog", "recipes", "landing", "newsletter"] },
    "content": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "$ref": "#/$defs/elementNode" }
      }
    }
  },
  "$defs": {
    "elementNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/anyNode" }
        }
      }
    },
    "anyNode": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/anyNode" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "claim" } } },
          "then": {
            "required": ["claimId", "children"],
            "properties": {
              "claimId": { "type": "string", "pattern": "^c[0-9]+$" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "link" } } },
          "then": {
            "required": ["fields"],
            "properties": {
              "fields": {
                "type": "object",
                "required": ["url"],
                "properties": { "url": { "type": "string" } }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "text" } } },
          "then": { "required": ["text"], "properties": { "text": { "type": "string" } } }
        }
      ]
    }
  }
}
