{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/opportunities.schema.json",
  "title": "Opportunities artifact",
  "description": "The synthesist's output: ranked candidates with the evidence each rests on, a stated bet rather than only a topic, and exclusions with reasons. Anything contradicting current positioning is excluded, with the contradiction named.",
  "type": "object",
  "additionalProperties": false,
  "required": ["period", "positioningHash", "basedOn", "opportunities", "excluded"],
  "properties": {
    "period": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$" },
    "positioningHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "basedOn": {
      "type": "object",
      "additionalProperties": false,
      "description": "The artifacts this synthesis rests on. Empty synthesis is opinion.",
      "properties": {
        "reads": { "type": "array", "items": { "type": "string" } },
        "demand": { "type": "array", "items": { "type": "string" } },
        "landscape": { "type": "array", "items": { "type": "string" } }
      }
    },
    "opportunities": {
      "type": "array",
      "description": "Ranked: order is priority.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "targetQuery", "surface", "bet", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^opp-[a-z0-9-]+$" },
          "title": { "type": "string", "minLength": 5 },
          "targetQuery": { "type": "string", "minLength": 3 },
          "surface": { "enum": ["blog", "recipes", "landing", "newsletter"] },
          "bet": {
            "type": "string",
            "minLength": 20,
            "description": "The stated bet: what we expect this piece to do and why — not only a topic."
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["artifact", "ref"],
              "properties": {
                "artifact": { "type": "string", "description": "Path of the read/demand/landscape artifact." },
                "ref": { "type": "string", "description": "Which finding or theme inside it." }
              }
            }
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "Candidates considered and excluded, each with its reason. Positioning contradictions land here, never in the ranked list.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "reason"],
        "properties": {
          "title": { "type": "string" },
          "reason": { "type": "string", "minLength": 8 }
        }
      }
    }
  }
}
