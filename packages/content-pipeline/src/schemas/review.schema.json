{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://carinyaparc.com.au/schemas/review.schema.json",
  "title": "Review record",
  "description": "Per piece, at merge. Ten seconds of human time, the only per-piece quality signal that arrives fast enough to act on, and the sole input to the shadow-review agent. A piece cannot be marked published with an incomplete record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "editDistance", "editLocus", "humanScore", "whatWasWrong", "gateAttempts", "publishedAt", "positioningHash"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "editDistance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Fraction of the staged draft surviving to publish. 1.0 = untouched."
    },
    "editLocus": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Which sections took the rewriting."
    },
    "humanScore": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Anchored to editorial-rubric.md. Supplied by the human at publish; the record cannot close without it."
    },
    "whatWasWrong": {
      "type": "string",
      "minLength": 1,
      "description": "Free text. 'nothing' is a valid answer; silence is not."
    },
    "gateAttempts": { "type": "integer", "minimum": 1, "description": "Passes before all gates green." },
    "publishedAt": { "type": "string", "format": "date-time" },
    "positioningHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "shadow": {
      "type": "object",
      "description": "Agent shadow verdicts paired with this record. Recorded before the human decided; never shown to them while deciding.",
      "additionalProperties": false,
      "properties": {
        "verdicts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["decisionClass", "verdict", "recordedAt"],
            "properties": {
              "decisionClass": { "type": "string" },
              "verdict": { "type": "string" },
              "recordedAt": { "type": "string", "format": "date-time" },
              "humanVerdict": { "type": "string" },
              "agrees": { "type": "boolean" }
            }
          }
        }
      }
    }
  }
}
